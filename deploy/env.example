# Copy to .env.staging on the staging machine. Never commit the copy.

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Staging: https:// + the machine's fixed office IP. Production: pms.sorsogon.gov.ph
SITE_ADDRESS=https://192.168.1.50

# Staging: internal. Production: an email address for Let's Encrypt.
CADDY_TLS=internal